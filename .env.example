# App Configuration
ENV=development
SECRET_KEY=change-this-to-a-super-secret-key-in-production
REFRESH_SECRET_KEY=change-this-to-another-super-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Neon free tier PostgreSQL or local PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/documind

# Redis / Celery (Upstash free tier or local Redis)
REDIS_URL=redis://localhost:6379/0

# Vector store (embedded ChromaDB directory)
CHROMA_PERSIST_DIR=./chroma_data

# LLM Provider Configuration (Google Gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Embedding Model (HuggingFace sentence-transformers local execution)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# File Upload Directory
UPLOAD_DIR=./uploads
